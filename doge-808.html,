<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>DOGE-808 BEAT CARD - Dogeparty NFT by PAPETO</title>
<meta property="og:title" content="DOGE-808 BEAT CARD - Dogeparty NFT by PAPETO">
<meta property="og:url" content="https://papetoart.github.io/papeto-cards/doge-808.html">
<link rel="canonical" href="https://papetoart.github.io/papeto-cards/doge-808.html">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-user-select: none; }
  body {
    background: radial-gradient(circle at top, #1e1b4b, #050507);
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100dvh;
    padding: 10px;
    overflow: hidden;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    touch-action: none;
  }
  #card-frame {
    position: relative;
    width: 96vw;
    max-width: 860px;
    aspect-ratio: 16 / 10;
    max-height: 92dvh;
    border: 3px solid #facc15;
    border-radius: 14px;
    box-shadow: 0 0 45px rgba(250, 204, 21, 0.45), inset 0 0 22px rgba(250, 204, 21, 0.18);
    background: #090d16;
    overflow: hidden;
  }
  canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
  #sig-badge {
    position: absolute;
    top: 8px;
    right: 10px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(250, 204, 21, 0.75);
    border-radius: 20px;
    color: #fef08a;
    font-size: clamp(8px, 1.3vw, 11px);
    font-weight: 800;
    padding: 3px 10px;
    letter-spacing: 0.8px;
    z-index: 5;
    pointer-events: none;
  }
  #in-card-controls {
    position: absolute;
    bottom: 10px;
    left: 10px;
    right: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 6px;
    z-index: 6;
    pointer-events: auto;
  }
  .pads {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .pad-btn {
    background: rgba(15, 23, 42, 0.86);
    backdrop-filter: blur(4px);
    border: 1.5px solid #facc15;
    color: #fef08a;
    font-weight: 900;
    font-size: clamp(9px, 1.45vw, 12px);
    padding: 7px 10px;
    border-radius: 10px;
    cursor: pointer;
    box-shadow: 0 3px 0 #854d0e;
  }
  .pad-btn.hit {
    transform: translateY(2px);
    background: #facc15;
    color: #09090b;
  }
  .loop-btn {
    background: rgba(20, 83, 45, 0.9);
    border: 1.5px solid #4ade80;
    color: #dcfce7;
    font-weight: 900;
    font-size: clamp(9px, 1.45vw, 12px);
    padding: 7px 11px;
    border-radius: 10px;
    cursor: pointer;
    box-shadow: 0 3px 0 #052e16;
    white-space: nowrap;
  }
  .loop-btn.off {
    background: rgba(30, 41, 59, 0.9);
    border-color: #64748b;
    color: #cbd5e1;
    box-shadow: 0 3px 0 #0f172a;
  }
</style>
</head>
<body>
<div id="card-frame">
  <div id="sig-badge">DOGEPARTY NFT &bull; BY PAPETO</div>
  <canvas id="beat-canvas" width="640" height="400"></canvas>

  <div id="in-card-controls">
    <div class="pads">
      <button id="p-kick" class="pad-btn" type="button">KICK [1]</button>
      <button id="p-bass" class="pad-btn" type="button">808 [2]</button>
      <button id="p-snare" class="pad-btn" type="button">CLAP [3]</button>
      <button id="p-arp" class="pad-btn" type="button">WOW [4]</button>
    </div>
    <button id="loop-btn" class="loop-btn" type="button">LOOP: ON</button>
  </div>
</div>

<script>
(function() {
  var canvas = document.getElementById('beat-canvas');
  var frame = document.getElementById('card-frame');
  var ctx = canvas.getContext('2d');
  var W = 640, H = 400;

  var audioCtx = null;
  var unlocked = false;

  function initAudio() {
    try {
      var AC = window.AudioContext || window.webkitAudioContext;
      if (AC && !audioCtx) audioCtx = new AC();
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
      if (audioCtx && audioCtx.state === 'running') unlocked = true;
    } catch (e) {}
  }

  frame.addEventListener('pointerdown', initAudio);

  var bounce = 0;
  var step = 0;
  var stepClock = 0;
  var loopOn = true;
  var sparks = [];
  var bars = [0.2, 0.35, 0.25, 0.4, 0.3, 0.45, 0.25, 0.35];

  function burst(col, n) {
    for (var i = 0; i < n; i++) {
      var a = Math.random() * Math.PI * 2;
      var sp = 2 + Math.random() * 5;
      sparks.push({
        x: 320, y: 185,
        vx: Math.cos(a) * sp, vy: Math.sin(a) * sp,
        life: 0.35 + Math.random() * 0.25,
        color: col
      });
    }
  }

  function hitKick() {
    initAudio();
    bounce = 1;
    bars[step % 8] = 1;
    burst('#facc15', 10);
    if (!audioCtx) return;
    var t = audioCtx.currentTime;
    var o = audioCtx.createOscillator();
    var g = audioCtx.createGain();
    o.type = 'sine';
    o.frequency.setValueAtTime(145, t);
    o.frequency.exponentialRampToValueAtTime(35, t + 0.16);
    g.gain.setValueAtTime(0.32, t);
    g.gain.exponentialRampToValueAtTime(0.002, t + 0.18);
    o.connect(g); g.connect(audioCtx.destination);
    o.start(t); o.stop(t + 0.19);
  }

  function hitBass() {
    initAudio();
    bounce = 0.85;
    bars[step % 8] = 0.9;
    burst('#fb923c', 10);
    if (!audioCtx) return;
    var t = audioCtx.currentTime;
    var o = audioCtx.createOscillator();
    var g = audioCtx.createGain();
    o.type = 'sawtooth';
    var notes = [55, 55, 73.42, 65.41];
    var f = notes[step % notes.length];
    o.frequency.setValueAtTime(f * 2, t);
    o.frequency.exponentialRampToValueAtTime(f, t + 0.22);
    g.gain.setValueAtTime(0.18, t);
    g.gain.exponentialRampToValueAtTime(0.003, t + 0.24);
    o.connect(g); g.connect(audioCtx.destination);
    o.start(t); o.stop(t + 0.25);
  }

  function hitClap() {
    initAudio();
    bounce = 0.65;
    bars[step % 8] = 0.8;
    burst('#38bdf8', 12);
    if (!audioCtx) return;
    var t = audioCtx.currentTime;
    var o = audioCtx.createOscillator();
    var g = audioCtx.createGain();
    o.type = 'triangle';
    o.frequency.setValueAtTime(1100, t);
    o.frequency.exponentialRampToValueAtTime(240, t + 0.09);
    g.gain.setValueAtTime(0.16, t);
    g.gain.exponentialRampToValueAtTime(0.003, t + 0.1);
    o.connect(g); g.connect(audioCtx.destination);
    o.start(t); o.stop(t + 0.11);
  }

  function hitArp() {
    initAudio();
    bounce = 0.75;
    bars[step % 8] = 0.95;
    burst('#4ade80', 12);
    if (!audioCtx) return;
    var t = audioCtx.currentTime;
    var scale = [440, 523.25, 659.25, 783.99, 880];
    var o = audioCtx.createOscillator();
    var g = audioCtx.createGain();
    o.type = 'square';
    o.frequency.setValueAtTime(scale[step % scale.length], t);
    g.gain.setValueAtTime(0.09, t);
    g.gain.exponentialRampToValueAtTime(0.002, t + 0.11);
    o.connect(g); g.connect(audioCtx.destination);
    o.start(t); o.stop(t + 0.12);
  }

  function flashBtn(id) {
    var el = document.getElementById(id);
    if (!el) return;
    el.classList.add('hit');
    setTimeout(function() { el.classList.remove('hit'); }, 110);
  }

  document.getElementById('p-kick').onpointerdown = function(e) { e.preventDefault(); flashBtn('p-kick'); hitKick(); };
  document.getElementById('p-bass').onpointerdown = function(e) { e.preventDefault(); flashBtn('p-bass'); hitBass(); };
  document.getElementById('p-snare').onpointerdown = function(e) { e.preventDefault(); flashBtn('p-snare'); hitClap(); };
  document.getElementById('p-arp').onpointerdown = function(e) { e.preventDefault(); flashBtn('p-arp'); hitArp(); };

  var loopBtn = document.getElementById('loop-btn');
  function toggleLoop() {
    initAudio();
    loopOn = !loopOn;
    loopBtn.textContent = 'LOOP: ' + (loopOn ? 'ON' : 'OFF');
    loopBtn.classList.toggle('off', !loopOn);
  }
  loopBtn.onpointerdown = function(e) { e.preventDefault(); toggleLoop(); };

  window.addEventListener('keydown', function(e) {
    if (e.repeat) return;
    if (e.code === 'Digit1') { flashBtn('p-kick'); hitKick(); }
    if (e.code === 'Digit2') { flashBtn('p-bass'); hitBass(); }
    if (e.code === 'Digit3') { flashBtn('p-snare'); hitClap(); }
    if (e.code === 'Digit4') { flashBtn('p-arp'); hitArp(); }
    if (e.code === 'Space') { e.preventDefault(); toggleLoop(); }
  });

  function update(dt) {
    if (audioCtx && audioCtx.state === 'running') unlocked = true;
    bounce = Math.max(0, bounce - dt * 3.2);
    for (var b = 0; b < bars.length; b++) {
      bars[b] = Math.max(0.15, bars[b] - dt * 1.4);
    }

    if (loopOn && unlocked) {
      stepClock += dt;
      if (stepClock >= 0.22) {
        stepClock -= 0.22;
        var s = step % 8;
        if (s === 0 || s === 4) hitKick();
        if (s === 2 || s === 6) hitBass();
        if (s === 4) hitClap();
        if (s === 3 || s === 7) hitArp();
        step++;
      }
    }

    for (var i = sparks.length - 1; i >= 0; i--) {
      var p = sparks[i];
      p.x += p.vx; p.y += p.vy;
      p.vy += 0.16; p.life -= dt;
      if (p.life <= 0) sparks.splice(i, 1);
    }
  }

  function render() {
    ctx.fillStyle = '#090d16';
    ctx.fillRect(0, 0, W, H);

    ctx.fillStyle = 'rgba(15, 23, 42, 0.88)';
    ctx.fillRect(0, 0, W, 34);
    ctx.font = '800 13px sans-serif';
    ctx.fillStyle = '#facc15';
    ctx.fillText('DOGE-808 CARD', 14, 22);

    for (var s = 0; s < 8; s++) {
      var lx = 155 + s * 22;
      ctx.fillStyle = (s === step % 8 && loopOn && unlocked) ? '#facc15' : '#1e293b';
      ctx.beginPath(); ctx.roundRect(lx, 11, 14, 12, 3); ctx.fill();
    }

    for (var i = 0; i < 8; i++) {
      var bh = bars[i] * 95;
      var bx = 140 + i * 48;
      ctx.fillStyle = i % 2 === 0 ? 'rgba(250, 204, 21, 0.26)' : 'rgba(56, 189, 248, 0.26)';
      ctx.beginPath(); ctx.roundRect(bx, 330 - bh, 32, bh, 5); ctx.fill();
    }

    var dy = 185 - bounce * 20;
    ctx.save();
    ctx.translate(320, dy);
    ctx.scale(1 + bounce * 0.08, 1 - bounce * 0.05);

    ctx.fillStyle = '#ca8a04';
    ctx.beginPath(); ctx.moveTo(-42, -26); ctx.lineTo(-32, -68); ctx.lineTo(-8, -32); ctx.fill();
    ctx.beginPath(); ctx.moveTo(42, -26); ctx.lineTo(32, -68); ctx.lineTo(8, -32); ctx.fill();

    ctx.fillStyle = '#facc15';
    ctx.beginPath(); ctx.ellipse(0, 0, 56, 44, 0, 0, Math.PI * 2); ctx.fill();

    ctx.fillStyle = '#fef9c3';
    ctx.beginPath(); ctx.ellipse(14, 10, 32, 20, 0, 0, Math.PI * 2); ctx.fill();

    ctx.fillStyle = '#09090b';
    ctx.beginPath(); ctx.arc(38, 6, 6, 0, Math.PI * 2); ctx.fill();
    ctx.beginPath(); ctx.arc(10, -8, 6, 0, Math.PI * 2); ctx.fill();
    ctx.beginPath(); ctx.arc(28, -8, 6, 0, Math.PI * 2); ctx.fill();
    ctx.restore();

    if (!unlocked) {
      ctx.fillStyle = 'rgba(15, 23, 42, 0.85)';
      ctx.beginPath(); ctx.roundRect(195, 255, 250, 28, 14); ctx.fill();
      ctx.strokeStyle = '#facc15'; ctx.lineWidth = 1.5; ctx.stroke();
      ctx.fillStyle = '#fef08a';
      ctx.font = '800 12px sans-serif';
      ctx.fillText('TAP CARD OR PAD TO START AUDIO', 214, 273);
    }

    for (var sp = 0; sp < sparks.length; sp++) {
      var pt = sparks[sp];
      ctx.fillStyle = pt.color;
      ctx.beginPath(); ctx.arc(pt.x, pt.y, 3.5, 0, Math.PI * 2); ctx.fill();
    }
  }

  var STEP = 1000 / 60, FIXED_DT = 1 / 60, last = performance.now(), acc = 0;
  function loop(now) {
    acc += Math.min(100, now - last);
    last = now;
    var steps = 0;
    while (acc >= STEP - 0.5 && steps < 4) { update(FIXED_DT); acc -= STEP; steps++; }
    render();
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);
})();
</script>
</body>
</html>
